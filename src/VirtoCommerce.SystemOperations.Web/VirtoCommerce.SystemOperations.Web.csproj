<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SonarQubeTestProject>false</SonarQubeTestProject>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Content Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
    <None Remove="dist\**" />
    <!-- Frontend assets — never treat as C# sources. -->
    <Compile Remove="node_modules\**" />
    <Compile Remove="app\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Localizations\**">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.SystemOperations.Core\VirtoCommerce.SystemOperations.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.SystemOperations.Data\VirtoCommerce.SystemOperations.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Content\system-operations\" />
  </ItemGroup>
</Project>
