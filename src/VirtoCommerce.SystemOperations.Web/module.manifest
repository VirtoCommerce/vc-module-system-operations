<?xml version="1.0" encoding="utf-8"?>
<module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <id>VirtoCommerce.SystemOperations</id>
  <version>3.1002.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1027.0</platformVersion>
  <dependencies />

  <title>System Operations</title>
  <description>Developer tools page with centralized platform maintenance operations.</description>

  <apps>
    <app id="system-operations">
      <title>System Operations</title>
      <description>Platform maintenance and diagnostic tools</description>
      <iconUrl>/apps/system-operations/logo.svg</iconUrl>
      <permission>platform:developer-tools:access</permission>
      <placement>MainMenu</placement>
    </app>
  </apps>

  <!--
    Manifest-declared platform settings. Read at runtime via
    `GET /api/platform/settings/v2/global/values` and the `useModuleSettings`
    composable. See docs/developer-guide/manifest-settings.md in vc-platform
    for the schema reference.
  -->
  <settings>
    <!-- Tunable replacement for the hardcoded 60-attempt × 2s polling loop
         in app/composables/useOperations.ts. Cold-start time on customer
         infra varies; ops can tune without a rebuild. -->
    <setting>
      <name>VirtoCommerce.SystemOperations.RestartTimeoutSeconds</name>
      <groupName>System Operations|Restart</groupName>
      <displayName>Restart polling timeout (seconds)</displayName>
      <valueType>PositiveInteger</valueType>
      <defaultValue>120</defaultValue>
    </setting>

    <!-- Production safety: hide Reset Cache and Restart Platform cards
         when false. Page still renders for diagnostics; just no one-click
         destructive actions. -->
    <setting>
      <name>VirtoCommerce.SystemOperations.AllowDestructiveOperations</name>
      <groupName>System Operations|Safety</groupName>
      <displayName>Allow destructive operations</displayName>
      <valueType>Boolean</valueType>
      <defaultValue>true</defaultValue>
    </setting>

    <!-- Platform-wide default theme; user override (localStorage) wins
         on a per-browser basis. Lets ops align the default with brand. -->
    <setting tenant="UserProfile">
      <name>VirtoCommerce.SystemOperations.DefaultTheme</name>
      <groupName>System Operations|UI</groupName>
      <displayName>Default theme</displayName>
      <valueType>ShortText</valueType>
      <defaultValue>system</defaultValue>
      <allowedValues>
        <value>system</value>
        <value>light</value>
        <value>dark</value>
      </allowedValues>
    </setting>

  </settings>

  <authors>
    <author>Oleg Zhuk</author>
  </authors>
  <owners>
    <owner>VirtoCommerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-system-operations</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.SystemOperations)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.SystemOperations.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.SystemOperations.Web.Module, VirtoCommerce.SystemOperations.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2026 VirtoCommerce. All rights reserved</copyright>
  <tags>developer-tools system operations maintenance</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
